# ── Local LLM (Ollama) ──────────────────────────────────────────────
# Make sure Ollama is running: `ollama serve`
# And the model is pulled:     `ollama pull llama3.2:3b`
OLLAMA_API_BASE=http://localhost:11434
ORCA_MODEL=ollama_chat/llama3.2:3b

# ── Copernicus Marine ───────────────────────────────────────────────
COPERNICUSMARINE_SERVICE_USERNAME=username
COPERNICUSMARINE_SERVICE_PASSWORD=password

# ── API server (marine_api + voice server) ──────────────────────────
ORCA_API_HOST=0.0.0.0
ORCA_API_PORT=8000

# ── CORS allowed origins (comma-separated) ──────────────────────────
# Leave blank to use defaults (localhost:5500, 7861, 3000, 8080)
ORCA_CORS_ORIGINS=

# ── Logging ─────────────────────────────────────────────────────────
PYTHONUTF8=1
ORCA_VERBOSE=0